# Optional OpenAI-compatible LLM planner. Never commit real keys.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---- 检索后端 ----
# baseline | clip | fusion | ann | partitioned
# ann 走 ANN 索引（faiss）；partitioned 走分段索引（过滤下推）。两者都需要先构建索引目录；
# 见 docs/SCALING.md
RETRIEVER_BACKEND=baseline
PLANNER_BACKEND=rule
CLIP_MODEL=OFA-Sys/chinese-clip-vit-base-patch16
MODEL_DEVICE=cpu
INDEX_DIR=data/index/chinese-clip-base

# ---- 阶段一：ANN 索引运行期旋钮 ----
# 只覆盖 efSearch / nprobe 这类"改了能立刻生效"的参数；
# 索引类型与维度以索引清单为准，不从环境变量取（HNSW 的 m、IVF 的 nlist 属构建期参数，
# 改了必须重建索引，所以刻意不暴露成环境变量）。
ANN_KIND=hnsw
ANN_DIMENSION=512
ANN_EF_SEARCH=64
ANN_NPROBE=32
# 粗召回 + 精确重排的候选数；0 表示关闭。开启后分数改为用 vectors.npy 重算，
# 因此要求索引保留向量（构建时不要加 --no-vectors）。
ANN_RERANK_CANDIDATES=0

# ---- 阶段二：无状态服务 ----
# memory（默认，单实例/测试）| redis（多副本共享）
SESSION_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600
CONTEXT_BUDGET=2048
MAX_STEPS=6
# 索引版本根目录。设置后 /index 才会返回版本状态。
INDEX_ROOT=

# ---- 阶段三：远端编码服务 ----
# 留空表示在本进程内做编码；设置后走 HTTP 到独立编码服务（scripts/serve_encoder.py）
ENCODER_BASE_URL=
ENCODER_CACHE_SIZE=4096
